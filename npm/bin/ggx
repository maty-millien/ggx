#!/bin/sh
set -eu

invoked_path=$0
case "$invoked_path" in
  /*) ;;
  */*) invoked_path="$(pwd)/$invoked_path" ;;
  *) invoked_path=$(command -v "$invoked_path") ;;
esac

script_path=$invoked_path
while [ -h "$script_path" ]; do
  link_target=$(readlink "$script_path")
  case "$link_target" in
    /*) script_path=$link_target ;;
    *) script_path="$(dirname "$script_path")/$link_target" ;;
  esac
done

script_dir=$(CDPATH= cd "$(dirname "$script_path")" && pwd)
package_dir=$(CDPATH= cd "$script_dir/.." && pwd)

if [ "${CI+x}" != x ]; then
  (
    if command -v bun >/dev/null 2>&1; then
      bun_bin=$(bun pm bin --global 2>/dev/null || :)
      bun_package_dir=$(CDPATH= cd "$bun_bin/../install/global/node_modules/ggx-ai" 2>/dev/null && pwd || :)
      if [ "$package_dir" = "$bun_package_dir" ]; then
        bun update --global --latest ggx-ai
        exit
      fi
    fi

    if command -v npm >/dev/null 2>&1; then
      npm_root=$(npm root --global 2>/dev/null || :)
      if [ "$package_dir" = "$npm_root/ggx-ai" ]; then
        npm update --global ggx-ai
      fi
    fi
  ) </dev/null >/dev/null 2>&1 &
fi

case "$(uname -s):$(uname -m)" in
  Darwin:arm64) target=aarch64-apple-darwin ;;
  Darwin:x86_64) target=x86_64-apple-darwin ;;
  Linux:aarch64 | Linux:arm64) target=aarch64-unknown-linux-gnu ;;
  Linux:x86_64 | Linux:amd64) target=x86_64-unknown-linux-gnu ;;
  *)
    echo "ggx does not support this operating system or architecture: $(uname -s) $(uname -m)" >&2
    exit 1
    ;;
esac

binary="$package_dir/vendor/$target/ggx"
if [ ! -x "$binary" ]; then
  echo "ggx binary is missing or not executable for $target" >&2
  exit 1
fi

exec "$binary" "$@"
